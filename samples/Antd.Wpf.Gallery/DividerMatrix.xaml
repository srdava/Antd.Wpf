<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:antd="https://antd-wpf.dev/xaml"
        Title="Antd.Wpf · Divider" Width="1120" Height="900" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
  <ItemsControl MinWidth="1000" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
    <ItemsControl.Items><x:Static Member="antd:ThemeMode.Light" /><x:Static Member="antd:ThemeMode.Dark" /></ItemsControl.Items>
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
      <antd:AntThemeScope Mode="{Binding}" MotionEnabled="False">
        <Border Background="{DynamicResource Antd.Brush.Container}" Padding="28" TextElement.Foreground="{DynamicResource Antd.Brush.Text}">
          <StackPanel>
            <TextBlock Text="{Binding StringFormat='Divider · {0}'}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20" />
            <TextBlock Text="Solid · Dashed · Dotted" Foreground="{DynamicResource Antd.Brush.Secondary}" />
            <antd:AntDivider />
            <antd:AntDivider Variant="Dashed" />
            <antd:AntDivider Variant="Dotted" />
            <TextBlock Text="Title placement" Foreground="{DynamicResource Antd.Brush.Secondary}" Margin="0,12,0,0" />
            <antd:AntDivider Content="Start" TitlePlacement="Start" />
            <antd:AntDivider Content="Center" />
            <antd:AntDivider Content="End" TitlePlacement="End" />
            <antd:AntDivider Content="Plain title / 普通标题" IsPlain="True" />
            <antd:AntDivider Content="Zero inset" TitlePlacement="Start" TitleInset="0" Variant="Dashed" />
            <antd:AntDivider Content="RTL · Start" TitlePlacement="Start" FlowDirection="RightToLeft" />
            <TextBlock Text="Vertical" Foreground="{DynamicResource Antd.Brush.Secondary}" Margin="0,12,0,16" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Text" VerticalAlignment="Center" />
              <antd:AntDivider Orientation="Vertical" />
              <TextBlock Text="Link" Foreground="{DynamicResource Antd.Brush.Link}" VerticalAlignment="Center" />
              <antd:AntDivider Orientation="Vertical" Variant="Dashed" />
              <TextBlock Text="Action" VerticalAlignment="Center" />
              <antd:AntDivider Orientation="Vertical" Variant="Dotted" />
              <TextBlock Text="More" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Small spacing" Foreground="{DynamicResource Antd.Brush.Secondary}" Margin="0,24,0,0" />
            <antd:AntDivider Content="Small" Size="Small" IsPlain="True" />
            <TextBlock Text="Text wraps in the page; divider titles keep one line and use the available width." TextWrapping="Wrap" Foreground="{DynamicResource Antd.Brush.Secondary}" Margin="0,12,0,0" />
          </StackPanel>
        </Border>
      </antd:AntThemeScope>
    </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  </ScrollViewer>
</Window>
