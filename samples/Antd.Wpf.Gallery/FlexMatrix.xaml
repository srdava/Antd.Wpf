<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:antd="https://antd-wpf.dev/xaml"
        Title="Antd.Wpf · Flex" Width="1120" Height="790" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
  <ItemsControl MinWidth="1000" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
    <ItemsControl.Items><x:Static Member="antd:ThemeMode.Light" /><x:Static Member="antd:ThemeMode.Dark" /></ItemsControl.Items>
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
      <antd:AntThemeScope Mode="{Binding}" MotionEnabled="False">
        <Border Background="{DynamicResource Antd.Brush.Container}" Padding="28" TextElement.Foreground="{DynamicResource Antd.Brush.Text}">
          <StackPanel>
            <TextBlock Text="{Binding StringFormat='Flex · {0}'}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20" />
            <TextBlock Text="Start · gap 8" Foreground="{DynamicResource Antd.Brush.Secondary}" Margin="0,0,0,12" />
            <antd:AntFlexPanel ColumnGap="8" AlignItems="Center">
              <antd:AntButton Content="Primary" Variant="Solid" SemanticColor="Primary" />
              <antd:AntButton Content="Default" />
              <antd:AntButton Content="Dashed" Variant="Dashed" />
            </antd:AntFlexPanel>
            <antd:AntDivider Content="Center · gap 16" IsPlain="True" />
            <antd:AntFlexPanel ColumnGap="16" JustifyContent="Center" AlignItems="Center">
              <antd:AntButton Content="Small" Size="Small" />
              <antd:AntButton Content="Medium" />
              <antd:AntButton Content="Large" Size="Large" />
            </antd:AntFlexPanel>
            <antd:AntDivider Content="End · gap 24" IsPlain="True" />
            <antd:AntFlexPanel ColumnGap="24" JustifyContent="End" AlignItems="End">
              <antd:AntButton Content="Default" />
              <antd:AntButton Content="Action" Variant="Solid" SemanticColor="Primary" />
            </antd:AntFlexPanel>
            <antd:AntDivider Content="Wrap · column gap 8 / row gap 8" IsPlain="True" />
            <antd:AntFlexPanel Wrap="True" ColumnGap="8" RowGap="8" AlignItems="Center">
              <antd:AntButton Content="One / 一" Width="112" Variant="Solid" SemanticColor="Primary" />
              <antd:AntButton Content="Two / 二" Width="112" />
              <antd:AntButton Content="Three / 三" Width="112" />
              <antd:AntButton Content="Four / 四" Width="112" />
              <antd:AntButton Content="Five / 五" Width="112" />
              <antd:AntButton Content="Six / 六" Width="112" />
            </antd:AntFlexPanel>
            <antd:AntDivider Content="SpaceBetween" IsPlain="True" />
            <antd:AntFlexPanel JustifyContent="SpaceBetween" ColumnGap="8">
              <antd:AntButton Content="Start" /><antd:AntButton Content="Middle" /><antd:AntButton Content="End" />
            </antd:AntFlexPanel>
            <antd:AntDivider Content="SpaceAround" IsPlain="True" />
            <antd:AntFlexPanel JustifyContent="SpaceAround" ColumnGap="8">
              <antd:AntButton Content="One" /><antd:AntButton Content="Two" /><antd:AntButton Content="Three" />
            </antd:AntFlexPanel>
            <antd:AntDivider Content="SpaceEvenly" IsPlain="True" />
            <antd:AntFlexPanel JustifyContent="SpaceEvenly" ColumnGap="8">
              <antd:AntButton Content="One" /><antd:AntButton Content="Two" /><antd:AntButton Content="Three" />
            </antd:AntFlexPanel>
            <antd:AntDivider Content="RTL · Start" IsPlain="True" />
            <antd:AntFlexPanel ColumnGap="8" FlowDirection="RightToLeft" AlignItems="Center">
              <antd:AntButton Content="First / 首项" Variant="Solid" SemanticColor="Primary" />
              <antd:AntButton Content="Second / 次项" />
            </antd:AntFlexPanel>
            <antd:AntDivider Content="Vertical · stretch · gap 8" IsPlain="True" />
            <antd:AntFlexPanel Orientation="Vertical" RowGap="8">
              <antd:AntInput Placeholder="Name / 姓名" />
              <antd:AntInput Placeholder="Email / 邮箱" />
            </antd:AntFlexPanel>
            <TextBlock Text="Vertical · center · gap 8" Foreground="{DynamicResource Antd.Brush.Secondary}" Margin="0,20,0,12" />
            <antd:AntFlexPanel Orientation="Vertical" RowGap="8" AlignItems="Center">
              <antd:AntButton Content="Continue / 继续" Variant="Solid" SemanticColor="Primary" />
              <antd:AntButton Content="Cancel / 取消" Variant="Text" />
            </antd:AntFlexPanel>
          </StackPanel>
        </Border>
      </antd:AntThemeScope>
    </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  </ScrollViewer>
</Window>
