<Window x:Class="Antd.Wpf.Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:antd="https://antd-wpf.dev/xaml"
        Title="Antd.Wpf · Component Gallery" Width="1100" Height="780" MinWidth="760" MinHeight="600"
        UseLayoutRounding="True" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
  <antd:AntThemeScope x:Name="Theme">
    <Grid Background="{DynamicResource Antd.Brush.Background}" TextElement.Foreground="{DynamicResource Antd.Brush.Text}">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border Background="{DynamicResource Antd.Brush.Container}" Padding="32,22" BorderBrush="{DynamicResource Antd.Brush.Border}" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <antd:AntButton Content="Small" Tag="Small" Click="ChangeSize" Margin="0,0,8,0" />
            <antd:AntButton Content="Middle" Tag="Middle" Click="ChangeSize" Margin="0,0,8,0" />
            <antd:AntButton Content="Large" Tag="Large" Click="ChangeSize" Margin="0,0,16,0" />
            <antd:AntButton Content="Light / Dark" Click="ToggleTheme" Variant="Filled" SemanticColor="Primary" />
            <antd:AntButton Content="Visual matrix" Click="ShowVisualMatrix" Margin="8,0,0,0" />
          </StackPanel>
          <StackPanel><TextBlock Text="Antd.Wpf" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="NATIVE WPF · FRAMEWORK 4.8 / .NET 8+" Foreground="{DynamicResource Antd.Brush.Secondary}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">
          <TextBlock Text="A familiar design. Native desktop behavior." FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
          <TextBlock Text="M0 · Themes, buttons, text input and a virtualized select. Switch themes without losing your input." Foreground="{DynamicResource Antd.Brush.Secondary}" Margin="0,0,0,24" TextWrapping="Wrap" />
          <Border Background="{DynamicResource Antd.Brush.Container}" BorderBrush="{DynamicResource Antd.Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,20">
            <StackPanel>
              <TextBlock Text="Buttons" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
              <WrapPanel>
                <antd:AntButton Content="_Primary" Variant="Solid" SemanticColor="Primary" Margin="0,0,12,12" />
                <antd:AntButton Content="Default" Margin="0,0,12,12" />
                <antd:AntButton Content="Dashed" Variant="Dashed" Margin="0,0,12,12" />
                <antd:AntButton Content="Filled" Variant="Filled" SemanticColor="Primary" Margin="0,0,12,12" />
                <antd:AntButton Content="Text" Variant="Text" Margin="0,0,12,12" />
                <antd:AntButton Content="Link" Variant="Link" Margin="0,0,12,12" />
                <antd:AntButton Content="Danger" Variant="Solid" SemanticColor="Danger" Margin="0,0,12,12" />
              </WrapPanel>
              <WrapPanel>
                <antd:AntButton Content="Create" Icon="＋" Shape="Round" Variant="Solid" SemanticColor="Primary" Margin="0,0,12,0" />
                <antd:AntButton Content="Next" Icon="→" IconPlacement="End" Margin="0,0,12,0" />
                <antd:AntButton Content="Disabled" IsEnabled="False" Margin="0,0,12,0" />
                <antd:AntButton Content="Save changes" IsLoading="{Binding IsBusy}" Click="Save" Variant="Solid" SemanticColor="Primary" LoadingDelay="0:0:0.15" />
              </WrapPanel>
              <TextBlock Text="{Binding SaveStatus}" Foreground="{DynamicResource Antd.Brush.Secondary}" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Antd.Brush.Container}" BorderBrush="{DynamicResource Antd.Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,20">
            <StackPanel>
              <TextBlock Text="Text input" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <Label Content="_Name" Target="{Binding ElementName=NameInput}" Foreground="{DynamicResource Antd.Brush.Text}" Padding="0,0,0,8" />
                  <antd:AntInput x:Name="NameInput" Placeholder="请输入内容 / Type here" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AllowClear="True" ShowCount="True" MaxLength="20" AutomationProperties.Name="Name" />
                  <TextBlock Text="{Binding InputText, StringFormat='Bound value: {0}'}" Foreground="{DynamicResource Antd.Brush.Secondary}" Margin="0,8,0,12" />
                  <antd:AntInput Placeholder="name@example.com" AutomationProperties.Name="Email" />
                  <antd:AntInput Text="Read-only content" IsReadOnly="True" AllowClear="True" Margin="0,12,0,0" AutomationProperties.Name="Read only" />
                  <TextBlock Text="超限绑定值保留原文 / Bound values are preserved" Margin="0,12,0,8" />
                  <antd:AntInput Text="超出长度限制 / Over limit" MaxLength="8" ShowCount="True" AllowClear="True" AutomationProperties.Name="Over limit input" />
                  <TextBlock Text="多行输入 · 2–4 行自动高度，超出后滚动" Margin="0,12,0,8" />
                  <antd:AntInput AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" MaxLines="4"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 VerticalContentAlignment="Top" Placeholder="输入多行内容 / Type multiple lines"
                                 AutomationProperties.Name="Multiline input" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Variants and validation" Margin="0,0,0,8" />
                  <antd:AntInput Placeholder="Filled" Variant="Filled" Margin="0,0,0,12" AutomationProperties.Name="Filled input" />
                  <antd:AntInput Text="Validation error" Status="Error" Margin="0,0,0,12" AutomationProperties.Name="Invalid input" />
                  <antd:AntInput Placeholder="Underlined" Variant="Underlined" AutomationProperties.Name="Underlined input" />
                  <TextBlock Text="Search · Enter / 按钮 / 清除，Esc 取消" Margin="0,16,0,8" />
                  <antd:AntInput IsSearchEnabled="True" Placeholder="默认图标搜索" Margin="0,0,0,8" AutomationProperties.Name="Icon search query" />
                  <antd:AntInput x:Name="SearchInput" IsSearchEnabled="True" SearchButtonContent="搜索"
                                 Placeholder="输入搜索内容" AllowClear="True" IsLoading="{Binding IsSearchBusy}"
                                 SearchRequested="Search" AutomationProperties.Name="Search query" />
                  <antd:AntButton Content="取消搜索" Click="CancelSearch" IsEnabled="{Binding IsSearchBusy}" Margin="0,8,0,0" HorizontalAlignment="Left" />
                  <TextBlock Text="{Binding SearchStatus}" TextWrapping="Wrap" Foreground="{DynamicResource Antd.Brush.Secondary}" Margin="0,8,0,0" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Antd.Brush.Container}" BorderBrush="{DynamicResource Antd.Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="24">
              <StackPanel><TextBlock Text="Select · 10,000 options" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                <antd:AntSelect ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" Placeholder="Choose an option" AutomationProperties.Name="Options" />
                <TextBlock Text="{Binding SelectedOption, StringFormat='Selected: {0}'}" Margin="0,12,0,0" Foreground="{DynamicResource Antd.Brush.Secondary}" />
              </StackPanel>
            </Border>
            <antd:AntThemeScope Grid.Column="2" Mode="Dark">
              <Border Background="{DynamicResource Antd.Brush.Container}" BorderBrush="{DynamicResource Antd.Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="24">
                <StackPanel><TextBlock Text="Local theme scope" Foreground="{DynamicResource Antd.Brush.Text}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                  <antd:AntInput Placeholder="Always dark" AutomationProperties.Name="Dark scope input" />
                  <antd:AntButton Content="Independent theme" Variant="Solid" SemanticColor="Primary" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
              </Border>
            </antd:AntThemeScope>
          </Grid>
          <Border Background="{DynamicResource Antd.Brush.Container}" BorderBrush="{DynamicResource Antd.Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,20,0,0">
            <StackPanel>
              <TextBlock Text="Switch · native two-state input" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
              <WrapPanel>
                <antd:AntSwitch CheckedContent="开" UncheckedContent="关" IsChecked="{Binding IsFeatureEnabled}" Margin="0,0,20,8" AutomationProperties.Name="Feature enabled" />
                <antd:AntSwitch Size="Small" IsChecked="True" Margin="0,0,20,8" AutomationProperties.Name="Small switch" />
                <antd:AntSwitch IsChecked="True" IsLoading="True" Margin="0,0,20,8" AutomationProperties.Name="Saving switch" />
                <antd:AntSwitch IsEnabled="False" Margin="0,0,20,8" AutomationProperties.Name="Disabled switch" />
                <antd:AntSwitch CheckedContent="即时" UncheckedContent="即时" antd:AntThemeScope.MotionEnabled="False" Margin="0,0,20,8" AutomationProperties.Name="Motion disabled switch" />
              </WrapPanel>
              <TextBlock Text="{Binding IsFeatureEnabled, StringFormat='Bound value: {0}'}" Foreground="{DynamicResource Antd.Brush.Secondary}" />
              <TextBlock Text="Thumb motion · 200 ms · “即时” switches immediately" Foreground="{DynamicResource Antd.Brush.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap" />
              <WrapPanel Margin="0,16,0,0">
                <antd:AntCheckBox Content="Checkbox" IsChecked="{Binding IsFeatureEnabled}" Margin="0,0,16,0" />
                <antd:AntCheckBox Content="Indeterminate" IsChecked="{x:Null}" Margin="0,0,16,0" />
                <antd:AntRadioButton Content="Option A" GroupName="demo" IsChecked="True" />
                <antd:AntRadioButton Content="Option B" GroupName="demo" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <antd:AntDivider Content="Layout" TitlePlacement="Start" />
          <antd:AntButton Content="Divider examples" HorizontalAlignment="Left" Click="ShowDividerMatrix" />
          <antd:AntButton Content="Flex examples" HorizontalAlignment="Left" Click="ShowFlexMatrix" Margin="0,8,0,0" />
          <antd:AntButton Content="Space examples" HorizontalAlignment="Left" Click="ShowSpaceMatrix" Margin="0,8,0,0" />
          <antd:AntButton Content="Grid examples" HorizontalAlignment="Left" Click="ShowGridMatrix" Margin="0,8,0,0" />
          <antd:AntButton Content="Layout examples" HorizontalAlignment="Left" Click="ShowLayoutMatrix" Margin="0,8,0,0" />
          <TextBlock Text="More components are specified in docs/components. This preview includes M0 and the first P1 input/layout slices." Foreground="{DynamicResource Antd.Brush.Secondary}" Margin="0,24,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </antd:AntThemeScope>
</Window>
