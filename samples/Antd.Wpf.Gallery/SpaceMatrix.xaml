<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:antd="https://antd-wpf.dev/xaml"
        Title="Antd.Wpf · Space" Width="1120" Height="860" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
  <Window.Resources>
    <DataTemplate x:Key="LineSeparator"><antd:AntDivider Orientation="Vertical" Margin="0" /></DataTemplate>
    <DataTemplate x:Key="DotSeparator"><TextBlock Text="·" Foreground="{DynamicResource Antd.Brush.Secondary}" /></DataTemplate>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
  <ItemsControl MinWidth="1000" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
    <ItemsControl.Items><x:Static Member="antd:ThemeMode.Light" /><x:Static Member="antd:ThemeMode.Dark" /></ItemsControl.Items>
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
      <antd:AntThemeScope Mode="{Binding}" MotionEnabled="False">
        <Border Background="{DynamicResource Antd.Brush.Container}" Padding="28" TextElement.Foreground="{DynamicResource Antd.Brush.Text}">
          <StackPanel>
            <TextBlock Text="{Binding StringFormat='Space · {0}'}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20" />
            <TextBlock Text="Default · gap 8 · center" Foreground="{DynamicResource Antd.Brush.Secondary}" Margin="0,0,0,12" />
            <antd:AntSpace>
              <antd:AntButton Content="Small" Size="Small" />
              <antd:AntButton Content="Medium" Variant="Solid" SemanticColor="Primary" />
              <antd:AntButton Content="Large" Size="Large" />
            </antd:AntSpace>
            <antd:AntDivider Content="Start · gap 16" IsPlain="True" />
            <antd:AntSpace Gap="16" Alignment="Start">
              <antd:AntButton Content="Small" Size="Small" />
              <antd:AntButton Content="Large" Size="Large" />
            </antd:AntSpace>
            <antd:AntDivider Content="Template separators" IsPlain="True" />
            <antd:AntSpace SeparatorTemplate="{StaticResource LineSeparator}">
              <antd:AntButton Content="First" Variant="Link" />
              <antd:AntButton Content="Second" Variant="Link" />
              <antd:AntButton Content="Third" Variant="Link" />
            </antd:AntSpace>
            <antd:AntDivider Content="Wrap · columns 8 / rows 16" IsPlain="True" />
            <antd:AntSpace Wrap="True" ColumnGap="8" RowGap="16" Width="240" HorizontalAlignment="Left" SeparatorTemplate="{StaticResource DotSeparator}">
              <antd:AntButton Content="First" Width="90" />
              <antd:AntButton Content="Second" Width="90" />
              <antd:AntButton Content="Third" Width="90" />
              <antd:AntButton Content="Fourth" Width="90" />
            </antd:AntSpace>
            <antd:AntDivider Content="RTL · template separators" IsPlain="True" />
            <antd:AntSpace FlowDirection="RightToLeft" SeparatorTemplate="{StaticResource DotSeparator}">
              <antd:AntButton Content="首项 / First" />
              <antd:AntButton Content="次项 / Second" />
            </antd:AntSpace>
            <antd:AntDivider Content="Vertical · stretch · gap 8" IsPlain="True" />
            <antd:AntSpace Orientation="Vertical">
              <antd:AntInput Placeholder="Name / 姓名" />
              <antd:AntInput Placeholder="Email / 邮箱" />
              <antd:AntButton Content="Continue / 继续" Variant="Solid" SemanticColor="Primary" />
            </antd:AntSpace>
          </StackPanel>
        </Border>
      </antd:AntThemeScope>
    </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  </ScrollViewer>
</Window>
