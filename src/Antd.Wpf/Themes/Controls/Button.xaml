<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Antd.Wpf.Controls"
                    xmlns:t="clr-namespace:Antd.Wpf.Theming">
  <Style TargetType="{x:Type c:AntButton}">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Antd.Brush.Container}" />
    <Setter Property="Foreground" Value="{DynamicResource Antd.Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="{DynamicResource Antd.FontSize}" />
    <Setter Property="TextBlock.LineHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.LineHeight}}" />
    <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="MinHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.ControlHeight.Middle}}" />
    <Setter Property="MinWidth" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.ControlHeight.Middle}}" />
    <Setter Property="Padding" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.Button.Padding.Middle}}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type c:AntButton}">
          <Grid>
            <Border x:Name="FocusRing" Margin="-4" BorderThickness="3"
                    BorderBrush="{DynamicResource Antd.Brush.FocusOutline}" CornerRadius="10"
                    Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="Shadow" Margin="0,2,0,-2" Background="{DynamicResource Antd.Brush.ButtonShadow}" CornerRadius="{DynamicResource Antd.CornerRadius}" IsHitTestVisible="False" />
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource Antd.CornerRadius}" Padding="{TemplateBinding Padding}">
              <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="IconHost" Grid.Column="0" Margin="0,0,8,0">
                  <ContentPresenter x:Name="Icon" Content="{TemplateBinding Icon}" VerticalAlignment="Center" />
                  <Path x:Name="Spinner" Data="M 8,0 A 8,8 0 1 1 0,8" Stroke="{TemplateBinding Foreground}"
                        StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" Visibility="Collapsed"
                        RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
                  </Path>
                </Grid>
                <ContentPresenter Grid.Column="1" RecognizesAccessKey="True" ContentSource="Content"
                                  VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Rectangle x:Name="DashedBorder" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"
                       StrokeDashArray="3,2" RadiusX="6" RadiusY="6" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="IconPlacement" Value="End">
              <Setter TargetName="IconHost" Property="Grid.Column" Value="2" />
              <Setter TargetName="IconHost" Property="Margin" Value="8,0,0,0" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="IconHost" Property="Margin" Value="0" /></Trigger>
            <Trigger Property="Size" Value="Small"><Setter TargetName="Chrome" Property="CornerRadius" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.CornerRadius.Small}}" /><Setter TargetName="Shadow" Property="CornerRadius" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.CornerRadius.Small}}" /><Setter TargetName="FocusRing" Property="CornerRadius" Value="8" /><Setter TargetName="DashedBorder" Property="RadiusX" Value="4" /><Setter TargetName="DashedBorder" Property="RadiusY" Value="4" /></Trigger>
            <Trigger Property="Size" Value="Large"><Setter TargetName="Chrome" Property="CornerRadius" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.CornerRadius.Large}}" /><Setter TargetName="Shadow" Property="CornerRadius" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.CornerRadius.Large}}" /><Setter TargetName="FocusRing" Property="CornerRadius" Value="12" /><Setter TargetName="DashedBorder" Property="RadiusX" Value="8" /><Setter TargetName="DashedBorder" Property="RadiusY" Value="8" /></Trigger>
            <Trigger Property="Shape" Value="Round">
              <Setter TargetName="Chrome" Property="CornerRadius" Value="16" />
              <Setter TargetName="Shadow" Property="CornerRadius" Value="16" />
              <Setter TargetName="FocusRing" Property="CornerRadius" Value="20" />
              <Setter TargetName="DashedBorder" Property="RadiusX" Value="16" />
              <Setter TargetName="DashedBorder" Property="RadiusY" Value="16" />
            </Trigger>
            <Trigger Property="Shape" Value="Circle">
              <Setter TargetName="Chrome" Property="CornerRadius" Value="999" />
              <Setter TargetName="Shadow" Property="CornerRadius" Value="999" />
              <Setter TargetName="FocusRing" Property="CornerRadius" Value="999" />
              <Setter TargetName="DashedBorder" Property="RadiusX" Value="999" />
              <Setter TargetName="DashedBorder" Property="RadiusY" Value="999" />
              <Setter TargetName="IconHost" Property="Margin" Value="0" />
            </Trigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="Shape" Value="Round" /><Condition Property="Size" Value="Small" /></MultiTrigger.Conditions><Setter TargetName="Chrome" Property="CornerRadius" Value="12" /><Setter TargetName="Shadow" Property="CornerRadius" Value="12" /><Setter TargetName="FocusRing" Property="CornerRadius" Value="16" /><Setter TargetName="DashedBorder" Property="RadiusX" Value="12" /><Setter TargetName="DashedBorder" Property="RadiusY" Value="12" /></MultiTrigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="Shape" Value="Round" /><Condition Property="Size" Value="Large" /></MultiTrigger.Conditions><Setter TargetName="Chrome" Property="CornerRadius" Value="20" /><Setter TargetName="Shadow" Property="CornerRadius" Value="20" /><Setter TargetName="FocusRing" Property="CornerRadius" Value="24" /><Setter TargetName="DashedBorder" Property="RadiusX" Value="20" /><Setter TargetName="DashedBorder" Property="RadiusY" Value="20" /></MultiTrigger>
            <Trigger Property="Variant" Value="Dashed">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent" />
              <Setter TargetName="DashedBorder" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="Solid" /><Condition Property="SemanticColor" Value="Primary" /></MultiTrigger.Conditions><Setter TargetName="Shadow" Property="Background" Value="{DynamicResource Antd.Brush.Outline}" /></MultiTrigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="Solid" /><Condition Property="SemanticColor" Value="Danger" /></MultiTrigger.Conditions><Setter TargetName="Shadow" Property="Background" Value="{DynamicResource Antd.Brush.ErrorOutline}" /></MultiTrigger>
            <Trigger Property="Variant" Value="Filled"><Setter TargetName="Shadow" Property="Opacity" Value="0" /></Trigger>
            <Trigger Property="Variant" Value="Text"><Setter TargetName="Shadow" Property="Opacity" Value="0" /></Trigger>
            <Trigger Property="Variant" Value="Link"><Setter TargetName="Shadow" Property="Opacity" Value="0" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shadow" Property="Opacity" Value="0" /></Trigger>
            <Trigger Property="IsGhost" Value="True"><Setter TargetName="Shadow" Property="Opacity" Value="0" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1" /></Trigger>
            <Trigger Property="IsLoadingVisible" Value="True">
              <Setter TargetName="IconHost" Property="Visibility" Value="Visible" />
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsLoadingVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                <Condition Binding="{Binding Path=(t:AntThemeScope.MotionEnabled), RelativeSource={RelativeSource Self}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <MultiDataTrigger.EnterActions>
                <BeginStoryboard x:Name="Spin">
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Spinner" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                     From="0" To="360" Duration="0:0:1" />
                  </Storyboard>
                </BeginStoryboard>
              </MultiDataTrigger.EnterActions>
              <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="Spin" /></MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Size" Value="Small"><Setter Property="MinHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.ControlHeight.Small}}" /><Setter Property="MinWidth" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.ControlHeight.Small}}" /><Setter Property="Padding" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.Button.Padding.Small}}" /></Trigger>
      <Trigger Property="Size" Value="Large"><Setter Property="MinHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.ControlHeight.Large}}" /><Setter Property="MinWidth" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.ControlHeight.Large}}" /><Setter Property="Padding" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.Button.Padding.Large}}" /><Setter Property="FontSize" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.FontSize.Large}}" /><Setter Property="TextBlock.LineHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.LineHeight.Large}}" /></Trigger>
