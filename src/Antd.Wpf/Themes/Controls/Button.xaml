      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="Filled" /><Condition Property="SemanticColor" Value="Default" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource Antd.Brush.Text}" /><Setter Property="Background" Value="{DynamicResource Antd.Brush.HoverFill}" /><Setter Property="BorderBrush" Value="Transparent" /></MultiTrigger>
