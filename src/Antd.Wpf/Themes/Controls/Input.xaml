<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Antd.Wpf.Controls"
                    xmlns:i="clr-namespace:Antd.Wpf.Internal"
                    xmlns:t="clr-namespace:Antd.Wpf.Theming">
  <DataTemplate x:Key="Antd.Input.SearchIcon">
    <Viewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type c:AntButton}}}"
             Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type c:AntButton}}}" IsHitTestVisible="False">
      <Canvas Width="1024" Height="1024">
        <Path Data="M909.6 854.5L649.9 594.8C690.2 542.7 712 479 712 412c0-80.2-31.3-155.4-87.9-212.1-56.6-56.7-132-87.9-212.1-87.9s-155.5 31.3-212.1 87.9C143.2 256.5 112 331.8 112 412c0 80.1 31.3 155.5 87.9 212.1C256.5 680.8 331.8 712 412 712c67 0 130.6-21.8 182.7-62l259.7 259.6a8.2 8.2 0 0 0 11.6 0l43.6-43.5a8.2 8.2 0 0 0 0-11.6zM570.4 570.4C528 612.7 471.8 636 412 636s-116-23.3-158.4-65.6C211.3 528 188 471.8 188 412s23.3-116.1 65.6-158.4C296 211.3 352.2 188 412 188s116.1 23.2 158.4 65.6S636 352.2 636 412s-23.3 116.1-65.6 158.4z"
              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type c:AntButton}}}" />
      </Canvas>
    </Viewbox>
  </DataTemplate>
  <Style x:Key="Antd.ClearButton" TargetType="Button">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource Antd.Brush.Secondary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="AutomationProperties.Name" Value="Clear" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10"><TextBlock Text="×" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Antd.Brush.HoverFill}" /></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="{x:Type c:AntInput}">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Antd.Brush.Container}" />
    <Setter Property="Foreground" Value="{DynamicResource Antd.Brush.Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Antd.Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Antd.Brush.Primary}" />
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="{DynamicResource Antd.FontSize}" />
    <Setter Property="TextBlock.LineHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.LineHeight}}" /><Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="MinHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.ControlHeight.Middle}}" /><Setter Property="Padding" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.Input.Padding.Middle}}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="{x:Type c:AntInput}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Border x:Name="FocusRing" Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource Antd.Brush.Outline}"
                  CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Antd.CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <ContentPresenter x:Name="Prefix" Content="{TemplateBinding Prefix}" VerticalAlignment="Center" Margin="0,0,4,0" />
              <Grid Grid.Column="1">
                <i:InputScrollViewer x:Name="PART_ContentHost" Padding="0" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource Antd.Brush.DisabledText}"
                           IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Grid>
              <Button x:Name="PART_ClearButton" Grid.Column="2" Style="{StaticResource Antd.ClearButton}" Margin="4,0,0,0" Visibility="Collapsed" />
              <ContentPresenter x:Name="Suffix" Grid.Column="4" Content="{TemplateBinding Suffix}" VerticalAlignment="Center" Margin="4,0,0,0" />
              <TextBlock x:Name="Count" Grid.Column="3" FlowDirection="LeftToRight" DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                         Foreground="{DynamicResource Antd.Brush.Tertiary}" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"><Run Text="{Binding Text.Length, Mode=OneWay}" /><Run x:Name="CountLimit" Text="{Binding MaxLength, StringFormat=' / {0}', Mode=OneWay}" /></TextBlock>
            </Grid>
          </Border>
          <c:AntButton x:Name="PART_SearchButton" Grid.Column="1" Margin="-1,0,0,0" Visibility="Collapsed"
                       Content="{TemplateBinding SearchButtonContent}" Style="{TemplateBinding SearchButtonStyle}"
                       Variant="Solid" SemanticColor="Primary" Size="{TemplateBinding Size}"
                       IsEnabled="{TemplateBinding CanSearch}" IsLoading="{TemplateBinding IsLoading}"
                       AutomationProperties.Name="Search">
            <c:AntButton.Resources>
              <CornerRadius x:Key="Antd.CornerRadius">0,6,6,0</CornerRadius>
              <CornerRadius x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.CornerRadius.Small}">0,4,4,0</CornerRadius>
              <CornerRadius x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.CornerRadius.Large}">0,8,8,0</CornerRadius>
            </c:AntButton.Resources>
          </c:AntButton>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Size" Value="Small"><Setter TargetName="Chrome" Property="CornerRadius" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.CornerRadius.Small}}" /><Setter TargetName="FocusRing" Property="CornerRadius" Value="6" /></Trigger>
          <Trigger Property="Size" Value="Large"><Setter TargetName="Chrome" Property="CornerRadius" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.CornerRadius.Large}}" /><Setter TargetName="FocusRing" Property="CornerRadius" Value="10" /></Trigger>
          <Trigger Property="IsSearchEnabled" Value="True"><Setter TargetName="PART_SearchButton" Property="Visibility" Value="Visible" /><Setter TargetName="Chrome" Property="CornerRadius" Value="6,0,0,6" /></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSearchEnabled" Value="True" /><Condition Property="Size" Value="Small" /></MultiTrigger.Conditions><Setter TargetName="Chrome" Property="CornerRadius" Value="4,0,0,4" /></MultiTrigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSearchEnabled" Value="True" /><Condition Property="Size" Value="Large" /></MultiTrigger.Conditions><Setter TargetName="Chrome" Property="CornerRadius" Value="8,0,0,8" /></MultiTrigger>
          <Trigger Property="Status" Value="Error"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Antd.Brush.ErrorOutline}" /></Trigger>
          <Trigger Property="Status" Value="Warning"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Antd.Brush.WarningOutline}" /></Trigger>
          <Trigger Property="Prefix" Value="{x:Null}"><Setter TargetName="Prefix" Property="Visibility" Value="Collapsed" /></Trigger>
          <Trigger Property="Suffix" Value="{x:Null}"><Setter TargetName="Suffix" Property="Visibility" Value="Collapsed" /></Trigger>
          <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible" /></Trigger>
          <Trigger Property="ShowCount" Value="True"><Setter TargetName="Count" Property="Visibility" Value="Visible" /></Trigger>
          <Trigger Property="MaxLength" Value="0"><Setter TargetName="CountLimit" Property="Text" Value="" /></Trigger>
          <Trigger Property="IsOverMaxLength" Value="True"><Setter TargetName="Count" Property="Foreground" Value="{DynamicResource Antd.Brush.Danger}" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Count" Property="Foreground" Value="{DynamicResource Antd.Brush.DisabledText}" /></Trigger>
          <Trigger Property="AllowClear" Value="True"><Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible" /></Trigger>
          <Trigger Property="Text" Value=""><Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" /></Trigger>
          <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" /></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSearchEnabled" Value="True" /><Condition Property="IsLoading" Value="True" /></MultiTrigger.Conditions><Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" /></MultiTrigger>
          <Trigger Property="Variant" Value="Underlined"><Setter TargetName="Chrome" Property="CornerRadius" Value="0" /></Trigger>
          <Trigger Property="SearchButtonContent" Value="{x:Null}">
            <Setter TargetName="PART_SearchButton" Property="Variant" Value="Outlined" />
            <Setter TargetName="PART_SearchButton" Property="SemanticColor" Value="Default" />
            <Setter TargetName="PART_SearchButton" Property="Padding" Value="0" />
            <Setter TargetName="PART_SearchButton" Property="ContentTemplate" Value="{StaticResource Antd.Input.SearchIcon}" />
          </Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="SearchButtonContent" Value="{x:Null}" /><Condition Property="IsLoading" Value="True" /></MultiTrigger.Conditions><Setter TargetName="PART_SearchButton" Property="ContentTemplate" Value="{x:Null}" /></MultiTrigger>
          <Trigger Property="Variant" Value="Borderless"><Setter TargetName="PART_SearchButton" Property="Variant" Value="Text" /></Trigger>
          <Trigger Property="Variant" Value="Underlined"><Setter TargetName="PART_SearchButton" Property="Variant" Value="Text" /></Trigger>
          <Trigger Property="Variant" Value="Filled"><Setter TargetName="PART_SearchButton" Property="Variant" Value="Text" /><Setter TargetName="PART_SearchButton" Property="Background" Value="{DynamicResource Antd.Brush.Fill}" /></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="Filled" /><Condition SourceName="PART_SearchButton" Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="PART_SearchButton" Property="Background" Value="{DynamicResource Antd.Brush.HoverFill}" /></MultiTrigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="Filled" /><Condition SourceName="PART_SearchButton" Property="IsPressed" Value="True" /></MultiTrigger.Conditions><Setter TargetName="PART_SearchButton" Property="Background" Value="{DynamicResource Antd.Brush.ActiveFill}" /></MultiTrigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="Size" Value="Small"><Setter Property="MinHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.ControlHeight.Small}}" /><Setter Property="Padding" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.Input.Padding.Small}}" /></Trigger>
      <Trigger Property="Size" Value="Large"><Setter Property="MinHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.ControlHeight.Large}}" /><Setter Property="Padding" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.Input.Padding.Large}}" /><Setter Property="FontSize" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.FontSize.Large}}" /><Setter Property="TextBlock.LineHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.LineHeight.Large}}" /></Trigger>
      <!-- WPF adds asymmetric leading to a fixed line box; center single-line native font metrics instead. -->
      <Trigger Property="AcceptsReturn" Value="False"><Setter Property="TextBlock.LineHeight" Value="NaN" /><Setter Property="TextBlock.LineStackingStrategy" Value="MaxHeight" /></Trigger>
      <Trigger Property="Variant" Value="Filled"><Setter Property="Background" Value="{DynamicResource Antd.Brush.Fill}" /><Setter Property="BorderBrush" Value="Transparent" /></Trigger>
      <Trigger Property="Variant" Value="Borderless"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Trigger>
      <Trigger Property="Variant" Value="Underlined"><Setter Property="BorderThickness" Value="0,0,0,1" /></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.PrimaryHover}" /></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Primary}" /></Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="Filled" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Antd.Brush.HoverFill}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="Filled" /><Condition Property="IsKeyboardFocusWithin" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Antd.Brush.Container}" /></MultiTrigger>
      <Trigger Property="Status" Value="Warning"><Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Warning}" /></Trigger>
      <Trigger Property="Status" Value="Error"><Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Danger}" /></Trigger>
      <Trigger Property="Validation.HasError" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Danger}" /></Trigger>
      <Trigger Property="IsOverMaxLength" Value="True"><Setter Property="Foreground" Value="{DynamicResource Antd.Brush.Danger}" /></Trigger>
      <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Path=(t:AntThemeScope.IsHighContrast), RelativeSource={RelativeSource Self}}" Value="True" /><Condition Binding="{Binding Status, RelativeSource={RelativeSource Self}}" Value="Error" /></MultiDataTrigger.Conditions><Setter Property="BorderThickness" Value="2" /></MultiDataTrigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Antd.Brush.DisabledText}" /><Setter Property="Background" Value="{DynamicResource Antd.Brush.DisabledFill}" /></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
