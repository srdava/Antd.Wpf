<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Antd.Wpf.Controls"
                    xmlns:t="clr-namespace:Antd.Wpf.Theming">
  <Style TargetType="{x:Type c:AntPasswordBox}">
    <Style.Resources>
      <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type c:AntPasswordBox}}}" />
        <Setter Property="CaretBrush" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type c:AntPasswordBox}}}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Antd.Brush.Primary}" />
        <Setter Property="MaxLength" Value="{Binding MaxLength, RelativeSource={RelativeSource AncestorType={x:Type c:AntPasswordBox}}}" />
        <Setter Property="PasswordChar" Value="{Binding PasswordChar, RelativeSource={RelativeSource AncestorType={x:Type c:AntPasswordBox}}}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource AncestorType={x:Type c:AntPasswordBox}}}" />
        <Setter Property="AutomationProperties.LabeledBy" Value="{Binding Path=(AutomationProperties.LabeledBy), RelativeSource={RelativeSource AncestorType={x:Type c:AntPasswordBox}}}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalContentAlignment="Center" />
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType={x:Type c:AntPasswordBox}}}" Value="Warning"><Setter Property="AutomationProperties.ItemStatus" Value="Warning" /></DataTrigger>
          <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType={x:Type c:AntPasswordBox}}}" Value="Error"><Setter Property="AutomationProperties.ItemStatus" Value="Error" /></DataTrigger>
          <DataTrigger Binding="{Binding Path=(Validation.HasError), RelativeSource={RelativeSource AncestorType={x:Type c:AntPasswordBox}}}" Value="True"><Setter Property="AutomationProperties.ItemStatus" Value="Error" /></DataTrigger>
        </Style.Triggers>
      </Style>
    </Style.Resources>
    <Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Background" Value="{DynamicResource Antd.Brush.Container}" /><Setter Property="Foreground" Value="{DynamicResource Antd.Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Border}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" /><Setter Property="FontSize" Value="{DynamicResource Antd.FontSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.ControlHeight.Middle}}" />
    <Setter Property="Padding" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.Input.Padding.Middle}}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type c:AntPasswordBox}">
      <Grid>
        <Border x:Name="FocusRing" Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource Antd.Brush.Outline}" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Antd.CornerRadius}" Padding="{TemplateBinding Padding}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ContentPresenter x:Name="PART_PasswordHost" VerticalAlignment="Center" />
            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource Antd.Brush.DisabledText}" IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed" />
            <Button x:Name="PART_ClearButton" Grid.Column="1" Style="{DynamicResource Antd.ClearButton}" Margin="4,0,0,0" Visibility="Collapsed" />
          </Grid>
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="Size" Value="Small"><Setter TargetName="Chrome" Property="CornerRadius" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.CornerRadius.Small}}" /><Setter TargetName="FocusRing" Property="CornerRadius" Value="6" /></Trigger>
        <Trigger Property="Size" Value="Large"><Setter TargetName="Chrome" Property="CornerRadius" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.CornerRadius.Large}}" /><Setter TargetName="FocusRing" Property="CornerRadius" Value="10" /></Trigger>
        <Trigger Property="IsEmpty" Value="True"><Setter TargetName="Placeholder" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="AllowClear" Value="True"><Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="IsEmpty" Value="True"><Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="Variant" Value="Underlined"><Setter TargetName="Chrome" Property="CornerRadius" Value="0" /></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="Size" Value="Small"><Setter Property="MinHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.ControlHeight.Small}}" /><Setter Property="Padding" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.Input.Padding.Small}}" /></Trigger>
      <Trigger Property="Size" Value="Large"><Setter Property="MinHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.ControlHeight.Large}}" /><Setter Property="Padding" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.Input.Padding.Large}}" /><Setter Property="FontSize" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.FontSize.Large}}" /></Trigger>
      <Trigger Property="Variant" Value="Filled"><Setter Property="Background" Value="{DynamicResource Antd.Brush.Fill}" /><Setter Property="BorderBrush" Value="Transparent" /></Trigger>
      <Trigger Property="Variant" Value="Borderless"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Trigger>
      <Trigger Property="Variant" Value="Underlined"><Setter Property="BorderThickness" Value="0,0,0,1" /></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.PrimaryHover}" /></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Primary}" /></Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="Filled" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Antd.Brush.HoverFill}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="Filled" /><Condition Property="IsKeyboardFocusWithin" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Antd.Brush.Container}" /></MultiTrigger>
      <Trigger Property="Status" Value="Warning"><Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Warning}" /></Trigger>
      <Trigger Property="Status" Value="Error"><Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Danger}" /></Trigger>
      <Trigger Property="Validation.HasError" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Danger}" /></Trigger>
      <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Path=(t:AntThemeScope.IsHighContrast), RelativeSource={RelativeSource Self}}" Value="True" /><Condition Binding="{Binding Status, RelativeSource={RelativeSource Self}}" Value="Error" /></MultiDataTrigger.Conditions><Setter Property="BorderThickness" Value="2" /></MultiDataTrigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Antd.Brush.DisabledText}" /><Setter Property="Background" Value="{DynamicResource Antd.Brush.DisabledFill}" /></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
