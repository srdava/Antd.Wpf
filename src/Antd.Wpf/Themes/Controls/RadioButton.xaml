<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:Antd.Wpf.Theming"
                    xmlns:c="clr-namespace:Antd.Wpf.Controls">
  <Style TargetType="{x:Type c:AntRadioButton}">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Antd.Brush.Text}" /><Setter Property="Background" Value="{DynamicResource Antd.Brush.Container}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Border}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" /><Setter Property="FontSize" Value="{DynamicResource Antd.FontSize}" />
    <Setter Property="TextBlock.LineHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.LineHeight}}" /><Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="MinHeight" Value="22" /><Setter Property="Padding" Value="8,0" /><Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type c:AntRadioButton}">
      <Grid Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid Width="16" Height="16" VerticalAlignment="Center">
          <Ellipse x:Name="FocusRing" Margin="-4" StrokeThickness="3" Stroke="{DynamicResource Antd.Brush.FocusOutline}" Opacity="0" IsHitTestVisible="False" />
          <Ellipse x:Name="Circle" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
          <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource Antd.Brush.White}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" />
        </Grid>
        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="{TemplateBinding Padding}" ContentSource="Content" RecognizesAccessKey="True" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="Label" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Opacity" Value="1" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Antd.Brush.DisabledText}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="FlowDirection" Value="RightToLeft"><Setter Property="Margin" Value="8,0,0,0" /></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Primary}" /></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource Antd.Brush.Primary}" /><Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Primary}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Antd.Brush.DisabledText}" /><Setter Property="Background" Value="{DynamicResource Antd.Brush.DisabledFill}" /><Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Border}" /></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
