<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:Antd.Wpf.Theming"
                    xmlns:c="clr-namespace:Antd.Wpf.Controls">
  <Style x:Key="Antd.SelectItem" TargetType="ComboBoxItem">
    <Setter Property="FontSize" Value="{DynamicResource Antd.FontSize}" />
    <Setter Property="TextBlock.LineHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.LineHeight}}" />
    <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Foreground" Value="{DynamicResource Antd.Brush.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.ControlHeight.Middle}}" /><Setter Property="Padding" Value="12,5" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.CornerRadius.Small}}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
      </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource Antd.Brush.ItemHover}" /></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Antd.Brush.Selection}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Antd.Brush.DisabledText}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type c:AntSelect}">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Antd.Brush.Text}" /><Setter Property="Background" Value="{DynamicResource Antd.Brush.Container}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Border}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" /><Setter Property="FontSize" Value="{DynamicResource Antd.FontSize}" />
    <Setter Property="TextBlock.LineHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.LineHeight}}" /><Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="MinHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.ControlHeight.Middle}}" /><Setter Property="Padding" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.Input.Padding.Middle}}" /><Setter Property="MaxDropDownHeight" Value="256" />
    <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" /><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Antd.SelectItem}" />
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></Setter.Value></Setter>
    <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type c:AntSelect}">
      <Grid x:Name="Root">
        <Border x:Name="FocusRing" BorderThickness="2" Margin="-2" BorderBrush="{DynamicResource Antd.Brush.Outline}" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Antd.CornerRadius}" Padding="{TemplateBinding Padding}">
          <Grid Margin="0,0,18,0">
            <ContentPresenter x:Name="Selection" IsHitTestVisible="False" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource Antd.Brush.DisabledText}"
                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
            <TextBox x:Name="PART_EditableTextBox" VerticalContentAlignment="Center" Padding="0" Background="Transparent" BorderThickness="0"
                     Foreground="{TemplateBinding Foreground}" IsReadOnly="{TemplateBinding IsReadOnly}" Visibility="Hidden" />
          </Grid>
        </Border>
        <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><ContentPresenter /></Border></ControlTemplate></ToggleButton.Template>
          <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Antd.Brush.Secondary}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" />
        </ToggleButton>
        <Button x:Name="PART_ClearButton" Width="20" Height="20" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                Focusable="False" Visibility="Collapsed" AutomationProperties.Name="Clear selection">
          <Button.Style><Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Antd.Brush.Tertiary}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
              <Border Background="Transparent">
                <Viewbox Width="12" Height="12" IsHitTestVisible="False"><Canvas Width="1024" Height="1024">
                  <Path Fill="{TemplateBinding Foreground}" Data="M512 64C264.6 64 64 264.6 64 512s200.6 448 448 448 448-200.6 448-448S759.4 64 512 64zm165.4 618.2l-66-.3L512 563.4l-99.3 118.4-66.1.3c-4.4 0-8-3.5-8-8 0-1.9.7-3.7 1.9-5.2l130.1-155L340.5 359a8.32 8.32 0 0 1-1.9-5.2c0-4.4 3.6-8 8-8l66.1.3L512 464.6l99.3-118.4 66-.3c4.4 0 8 3.5 8 8 0 1.9-.7 3.7-1.9 5.2L553.5 514l130 155c1.2 1.5 1.9 3.3 1.9 5.2 0 4.4-3.6 8-8 8z" />
                </Canvas></Viewbox>
              </Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Antd.Brush.Secondary}" /></Trigger></Style.Triggers>
          </Style></Button.Style>
        </Button>
        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
          <Border x:Name="PopupRoot" Margin="0,4,0,4" MinWidth="{Binding ActualWidth, ElementName=Root}"
                  Background="{DynamicResource Antd.Brush.Elevated}" BorderBrush="{DynamicResource Antd.Brush.Border}"
                  BorderThickness="0" CornerRadius="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.CornerRadius.Large}}" Padding="4" TextElement.Foreground="{DynamicResource Antd.Brush.Text}">
            <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
            </ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="Size" Value="Small"><Setter TargetName="Chrome" Property="CornerRadius" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.CornerRadius.Small}}" /></Trigger>
        <Trigger Property="Size" Value="Large"><Setter TargetName="Chrome" Property="CornerRadius" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.CornerRadius.Large}}" /></Trigger>
        <Trigger Property="SelectedIndex" Value="-1"><Setter TargetName="Placeholder" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" /><Setter TargetName="Selection" Property="Visibility" Value="Hidden" /><Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" /></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="AllowClear" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible" /></MultiTrigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="AllowClear" Value="True" /><Condition Property="IsKeyboardFocusWithin" Value="True" /></MultiTrigger.Conditions><Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible" /></MultiTrigger>
        <Trigger Property="SelectedIndex" Value="-1"><Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger SourceName="PART_ClearButton" Property="Visibility" Value="Visible"><Setter TargetName="Arrow" Property="Visibility" Value="Hidden" /></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="Size" Value="Small"><Setter Property="MinHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.ControlHeight.Small}}" /><Setter Property="Padding" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.Input.Padding.Small}}" /></Trigger>
      <Trigger Property="Size" Value="Large"><Setter Property="MinHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.ControlHeight.Large}}" /><Setter Property="Padding" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.Input.Padding.Large}}" /><Setter Property="FontSize" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.FontSize.Large}}" /><Setter Property="TextBlock.LineHeight" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.LineHeight.Large}}" /></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.PrimaryHover}" /></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Primary}" /></Trigger>
      <Trigger Property="Status" Value="Warning"><Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Warning}" /></Trigger>
      <Trigger Property="Status" Value="Error"><Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Danger}" /></Trigger>
      <Trigger Property="Validation.HasError" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Danger}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Antd.Brush.DisabledText}" /><Setter Property="Background" Value="{DynamicResource Antd.Brush.DisabledFill}" /></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
