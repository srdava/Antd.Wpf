<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Antd.Wpf.Controls"
                    xmlns:t="clr-namespace:Antd.Wpf.Theming">
  <Style TargetType="{x:Type c:AntSwitch}">
    <Setter Property="Background" Value="{DynamicResource Antd.Brush.Quaternary}" />
    <Setter Property="Foreground" Value="{DynamicResource Antd.Brush.White}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Antd.Brush.Border}" />
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" /><Setter Property="FontSize" Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type t:AntThemeScope}, ResourceId=Antd.FontSize.Small}}" />
    <Setter Property="TextBlock.LineHeight" Value="NaN" /><Setter Property="TextBlock.LineStackingStrategy" Value="MaxHeight" />
    <Setter Property="MinWidth" Value="44" /><Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="24,0,9,0" />
    <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type c:AntSwitch}">
      <Grid>
        <Border x:Name="FocusRing" Margin="-4" BorderThickness="3" CornerRadius="15" BorderBrush="{DynamicResource Antd.Brush.FocusOutline}" Opacity="0" IsHitTestVisible="False" />
        <Border x:Name="Track" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="11">
          <Grid>
            <ContentPresenter x:Name="Label" Content="{TemplateBinding UncheckedContent}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Border x:Name="Thumb" HorizontalAlignment="Left" VerticalAlignment="Center" Width="18" Height="18" Margin="2" CornerRadius="9" Background="{DynamicResource Antd.Brush.White}">
              <Border.RenderTransform><TranslateTransform x:Name="ThumbTranslation" /></Border.RenderTransform>
              <TextBlock x:Name="Busy" Text="…" Foreground="{DynamicResource Antd.Brush.Primary}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Border>
          </Grid>
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="Label" Property="Content" Value="{Binding CheckedContent, RelativeSource={RelativeSource TemplatedParent}}" />
          <Setter TargetName="Label" Property="Margin" Value="9,0,24,0" />
        </Trigger>
        <Trigger Property="Size" Value="Small">
          <Setter TargetName="Thumb" Property="Width" Value="12" />
          <Setter TargetName="Thumb" Property="Height" Value="12" />
          <Setter TargetName="Thumb" Property="CornerRadius" Value="6" />
          <Setter TargetName="Track" Property="CornerRadius" Value="8" />
          <Setter TargetName="FocusRing" Property="CornerRadius" Value="12" />
          <Setter TargetName="Label" Property="Margin" Value="18,0,6,0" />
        </Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="Size" Value="Small" /><Condition Property="IsChecked" Value="True" /></MultiTrigger.Conditions>
          <Setter TargetName="Label" Property="Margin" Value="6,0,18,0" />
        </MultiTrigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1" /></Trigger>
        <Trigger Property="IsLoading" Value="True"><Setter TargetName="Busy" Property="Visibility" Value="Visible" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="Size" Value="Small"><Setter Property="MinWidth" Value="28" /><Setter Property="MinHeight" Value="16" /></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Antd.Brush.Tertiary}" /></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource Antd.Brush.Primary}" /><Setter Property="Foreground" Value="{DynamicResource Antd.Brush.White}" /></Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Antd.Brush.PrimaryHover}" />
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65" /></Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEnabled" Value="False" /><Condition Property="t:AntThemeScope.IsHighContrast" Value="True" /></MultiTrigger.Conditions>
        <Setter Property="Opacity" Value="1" /><Setter Property="Background" Value="{DynamicResource Antd.Brush.DisabledText}" />
      </MultiTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
